# Standalone fallback only: if you run scripts/say.py OUTSIDE Muse,
# copy this file to .env and fill in your key. Never commit .env.
# Inside Muse (recommended), fill the key in the secure form in chat
# instead — nothing to put in a file.
# Get a key: https://www.volcengine.com/ — console > 语音合成 >
# enable the service and seed-tts-2.0, create an app, copy the API key.
VOLCENGINE_API_KEY=

# Default voice for spoken replies. Change to any speaker in voices.md.
MUSE_VOICE_SPEAKER=zh_female_sajiaoxuemei_uranus_bigtts
